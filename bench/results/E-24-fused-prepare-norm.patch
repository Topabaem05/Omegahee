diff --git a/engine/crates/uzu-engine/src/backends/metal/kernel/attention/attention_prepare_norm.metal b/engine/crates/uzu-engine/src/backends/metal/kernel/attention/attention_prepare_norm.metal
new file mode 100644
index 00000000..b41a3a7a
--- /dev/null
+++ b/engine/crates/uzu-engine/src/backends/metal/kernel/attention/attention_prepare_norm.metal
@@ -0,0 +1,128 @@
+#include <metal_stdlib>
+#include "../common/defines.h"
+#include "../common/dsl.h"
+
+using namespace metal;
+
+#define PREPARE_NORM_GRAIN 4
+
+// QKVNorm on the query and key heads followed by AttentionPrepare, in one dispatch. One SIMD group handles one
+// head of one token with QKVNorm's lane layout and reduction order, so the normalized values (rounded to
+// ElementT) are the ones QKVNorm would have written; RoPE, the query scales and the KV append then follow
+// AttentionPrepare. Value heads are copied unnormalized. Both norms use the same upcast mode and reduction, and
+// either both have per-element scales or neither has (nGPT's unit norms).
+template <typename ElementT>
+METAL_FUNC ElementT prepare_norm_value(
+    const device ElementT* head,
+    const device float* scales,
+    uint32_t index,
+    float rms,
+    float scale_offset,
+    bool has_scales,
+    bool full_layer
+) {
+  const float normalized_high = static_cast<float>(head[index]) * rms;
+  if (!has_scales) {
+    return static_cast<ElementT>(normalized_high);
+  }
+  if (full_layer) {
+    return static_cast<ElementT>(normalized_high * (scales[index] + scale_offset));
+  }
+  const ElementT normalized_low = static_cast<ElementT>(normalized_high);
+  const ElementT scale_value_low = static_cast<ElementT>(scales[index] + scale_offset);
+  return static_cast<ElementT>(normalized_low * scale_value_low);
+}
+
+template <typename ElementT, typename RopeT>
+VARIANTS(ElementT, bfloat)
+VARIANTS(RopeT, float)
+PUBLIC KERNEL(AttentionPrepareNorm)(
+    const device ElementT* qkvg, // [token, input_row_stride], with an optional trailing gate
+    device ElementT* queries, // [head_idx, token, head_dim]
+    device ElementT* keys OPTIONAL(has_kv), // [(kv_token_offset + token), head_idx, head_dim]
+    device ElementT* values OPTIONAL(has_kv), // [(kv_token_offset + token), head_idx, head_dim]
+    const device RopeT* cosines OPTIONAL(has_rope),
+    const device RopeT* sines OPTIONAL(has_rope),
+    const device float* query_scales OPTIONAL(has_query_scales), // [num_q_heads * head_dim], after RoPE
+    const device float* query_norm_scales OPTIONAL(has_norm_scales), // [head_dim]
+    const device float* key_norm_scales OPTIONAL(has_norm_scales), // [head_dim]
+    const constant uint32_t& num_q_heads,
+    const constant uint32_t& num_kv_heads OPTIONAL(has_kv),
+    const constant uint32_t& head_dim,
+    const constant uint32_t& rope_dim OPTIONAL(has_rope),
+    const constant uint32_t& kv_token_offset OPTIONAL(has_kv),
+    const constant uint32_t& input_row_stride,
+    const constant uint32_t& batch_dim,
+    const constant float& query_epsilon,
+    const constant float& key_epsilon,
+    const constant float& query_scale_offset,
+    const constant float& key_scale_offset,
+    const bool has_kv SPECIALIZE,
+    const bool has_rope SPECIALIZE,
+    const bool has_query_scales SPECIALIZE,
+    const bool full_layer SPECIALIZE,
+    const bool sum_reduction SPECIALIZE,
+    const bool has_norm_scales SPECIALIZE,
+    const uint32_t head_idx GROUPS(num_q_heads + num_kv_heads.unwrap_or(0) * 2),
+    const uint32_t batch_idx GROUPS(batch_dim),
+    const uint32_t lane THREADS(METAL_SIMD_SIZE)
+) {
+  const device ElementT* head = qkvg + batch_idx * input_row_stride + head_idx * head_dim;
+  const bool is_query = head_idx < num_q_heads;
+  const bool is_key = has_kv && !is_query && head_idx < num_q_heads + num_kv_heads;
+  const bool normalized = is_query || is_key;
+  const device float* norm_scales = is_query ? query_norm_scales : key_norm_scales;
+  const float epsilon = is_query ? query_epsilon : key_epsilon;
+  const float scale_offset = is_query ? query_scale_offset : key_scale_offset;
+
+  float rms = 1.0f;
+  if (normalized) {
+    float partial_sum = 0.0f;
+    for (uint32_t base = lane * PREPARE_NORM_GRAIN; base < head_dim; base += METAL_SIMD_SIZE * PREPARE_NORM_GRAIN) {
+      float vals[PREPARE_NORM_GRAIN];
+      for (uint32_t j = 0; j < PREPARE_NORM_GRAIN; ++j) {
+        const uint32_t i = base + j;
+        vals[j] = i < head_dim ? static_cast<float>(head[i]) : 0.0f;
+      }
+      for (uint32_t j = 0; j < PREPARE_NORM_GRAIN; ++j) {
+        partial_sum += vals[j] * vals[j];
+      }
+    }
+    const float total_sum = simd_sum(partial_sum);
+    const float mean_square = sum_reduction ? total_sum : total_sum / static_cast<float>(head_dim);
+    rms = rsqrt(mean_square + epsilon);
+  }
+
+  for (uint32_t base = lane * PREPARE_NORM_GRAIN; base < head_dim; base += METAL_SIMD_SIZE * PREPARE_NORM_GRAIN) {
+    for (uint32_t j = 0; j < PREPARE_NORM_GRAIN; ++j) {
+      const uint32_t i = base + j;
+      if (i >= head_dim) {
+        continue;
+      }
+      ElementT element = normalized ? prepare_norm_value(head, norm_scales, i, rms, scale_offset, has_norm_scales, full_layer) : head[i];
+      if (has_rope && i < rope_dim && normalized) {
+        const uint32_t half_rope_dim = rope_dim / 2;
+        const uint32_t paired_index = i < half_rope_dim ? i + half_rope_dim : i - half_rope_dim;
+        const float paired =
+            static_cast<float>(prepare_norm_value(head, norm_scales, paired_index, rms, scale_offset, has_norm_scales, full_layer));
+        const float signed_paired = i < half_rope_dim ? -paired : paired;
+        const float cos_val = static_cast<float>(cosines[batch_idx * rope_dim + i]);
+        const float sin_val = static_cast<float>(sines[batch_idx * rope_dim + i]);
+        element = static_cast<ElementT>(static_cast<float>(element) * cos_val + signed_paired * sin_val);
+      }
+      if (is_query && has_query_scales) {
+        element = static_cast<ElementT>(static_cast<float>(element) * query_scales[head_idx * head_dim + i]);
+      }
+      if (is_query) {
+        queries[head_idx * batch_dim * head_dim + batch_idx * head_dim + i] = element;
+      } else if (is_key) {
+        keys[(kv_token_offset + batch_idx) * num_kv_heads * head_dim + (head_idx - num_q_heads) * head_dim + i] =
+            element;
+      } else if (has_kv) {
+        values
+            [(kv_token_offset + batch_idx) * num_kv_heads * head_dim + (head_idx - num_q_heads - num_kv_heads) * head_dim +
+             i] = element;
+      }
+    }
+  }
+}
