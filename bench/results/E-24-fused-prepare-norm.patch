+    /// The fused prepare covers query and key norms with the same upcast mode and reduction, both scaled or
+    /// both unscaled, and no value norm.
+    pub(super) fn fused_prepare_params(&self) -> Option<FusedNormParams<'_, B>> {
+        let (Some(query), Some(key), None) = (&self.query, &self.key, &self.value) else {
+            return None;
+        };
+        if query.scales.is_some() != key.scales.is_some() {
+            return None;
+        }
+        let full_layer = query.config.upcast_mode == UpcastMode::FullLayer;
+        let sum_reduction = query.config.reduction == NormReduction::Sum;
+        let same_mode = full_layer == (key.config.upcast_mode == UpcastMode::FullLayer)
+            && sum_reduction == (key.config.reduction == NormReduction::Sum);
+        (same_mode && self.num_kv_heads.is_some()).then(|| FusedNormParams {
+            query_scales: query.scales.as_ref(),
+            key_scales: key.scales.as_ref(),
+            query_epsilon: query.config.epsilon,
+            key_epsilon: key.config.epsilon,
+            query_scale_offset: query.config.scale_offset.unwrap_or(0.0),
+            key_scale_offset: key.config.scale_offset.unwrap_or(0.0),
+            full_layer,
+            sum_reduction,
+        })
+    }
