@@ -0,0 +1,136 @@
+use half::bf16;
+use num_traits::Float;
+use uzu_engine_macros::kernel;
+
+use crate::data_type::DataTypeRepr;
+
+/// QKVNorm on the query and key heads, then AttentionPrepare (RoPE, query scales, KV append), as the two
+/// kernels compute them. Value heads are copied unnormalized. The norms have per-element scales or none.
+#[kernel(AttentionPrepareNorm)]
+#[variants(ElementT, bf16)]
+#[variants(RopeT, f32)]
+pub fn attention_prepare_norm<ElementT: DataTypeRepr + Float, RopeT: DataTypeRepr + Float>(
+    qkvg: *const ElementT,
+    queries: *mut ElementT,
+    #[optional(has_kv)] keys: Option<*mut ElementT>,
+    #[optional(has_kv)] values: Option<*mut ElementT>,
+    #[optional(has_rope)] cosines: Option<*const RopeT>,
+    #[optional(has_rope)] sines: Option<*const RopeT>,
+    #[optional(has_query_scales)] query_scales: Option<*const f32>,
+    #[optional(has_norm_scales)] query_norm_scales: Option<*const f32>,
+    #[optional(has_norm_scales)] key_norm_scales: Option<*const f32>,
+    num_q_heads: u32,
+    #[optional(has_kv)] num_kv_heads: Option<u32>,
+    head_dim: u32,
+    #[optional(has_rope)] rope_dim: Option<u32>,
+    #[optional(has_kv)] kv_token_offset: Option<u32>,
+    input_row_stride: u32,
+    batch_dim: u32,
+    query_epsilon: f32,
+    key_epsilon: f32,
+    query_scale_offset: f32,
+    key_scale_offset: f32,
+    #[specialize] has_kv: bool,
+    #[specialize] has_rope: bool,
+    #[specialize] has_query_scales: bool,
+    #[specialize] full_layer: bool,
+    #[specialize] sum_reduction: bool,
+    #[specialize] has_norm_scales: bool,
+) {
+    assert_eq!(keys.is_some(), has_kv, "attention prepare norm keys presence mismatch");
+    assert_eq!(cosines.is_some(), has_rope, "attention prepare norm cosines presence mismatch");
+    assert_eq!(query_scales.is_some(), has_query_scales, "attention prepare norm query_scales presence mismatch");
+    assert_eq!(query_norm_scales.is_some(), has_norm_scales, "attention prepare norm scales presence mismatch");
+    let num_q_heads = num_q_heads as usize;
+    let num_kv_heads = num_kv_heads.unwrap_or(0) as usize;
+    let head_dim = head_dim as usize;
+    let rope_dim = rope_dim.unwrap_or(0) as usize;
+    let kv_token_offset = kv_token_offset.unwrap_or(0) as usize;
+    let batch_dim = batch_dim as usize;
+    let total_heads = num_q_heads + 2 * num_kv_heads;
+    let mut head_values = vec![ElementT::zero(); head_dim];
+
+    for batch_idx in 0..batch_dim {
+        for head_idx in 0..total_heads {
+            let head = unsafe { qkvg.add(batch_idx * input_row_stride as usize + head_idx * head_dim) };
+            let is_query = head_idx < num_q_heads;
+            let is_key = has_kv && !is_query && head_idx < num_q_heads + num_kv_heads;
+            let read = |index: usize| unsafe { (*head.add(index)).to_f32().unwrap() };
+            if is_query || is_key {
+                let (scales, epsilon, scale_offset) = if is_query {
+                    (query_norm_scales, query_epsilon, query_scale_offset)
+                } else {
+                    (key_norm_scales, key_epsilon, key_scale_offset)
+                };
+                let total_sum =
+                    (0..head_dim).map(|index| read(index) * read(index)).fold(0.0f32, |sum, value| sum + value);
+                let mean_square = if sum_reduction {
+                    total_sum
+                } else {
+                    total_sum / head_dim as f32
+                };
+                let rms = (mean_square + epsilon).sqrt().recip();
+                for (index, value) in head_values.iter_mut().enumerate() {
+                    let normalized = read(index) * rms;
+                    *value = match scales {
+                        None => ElementT::from(normalized).unwrap(),
+                        Some(scales) => {
+                            let scale = unsafe { *scales.add(index) } + scale_offset;
+                            if full_layer {
+                                ElementT::from(normalized * scale).unwrap()
+                            } else {
+                                ElementT::from(normalized).unwrap() * ElementT::from(scale).unwrap()
+                            }
+                        },
+                    };
+                }
+            } else {
+                for (index, value) in head_values.iter_mut().enumerate() {
+                    *value = unsafe { *head.add(index) };
+                }
+            }
+
+            for index in 0..head_dim {
+                let mut element = head_values[index];
+                if has_rope && index < rope_dim && (is_query || is_key) {
+                    let half_rope_dim = rope_dim / 2;
+                    let paired_index = if index < half_rope_dim {
+                        index + half_rope_dim
+                    } else {
+                        index - half_rope_dim
+                    };
+                    let paired = head_values[paired_index].to_f32().unwrap();
+                    let signed_paired = if index < half_rope_dim {
+                        -paired
+                    } else {
+                        paired
+                    };
+                    let cos_val = unsafe { (*cosines.unwrap().add(batch_idx * rope_dim + index)).to_f32().unwrap() };
+                    let sin_val = unsafe { (*sines.unwrap().add(batch_idx * rope_dim + index)).to_f32().unwrap() };
+                    element = ElementT::from(element.to_f32().unwrap() * cos_val + signed_paired * sin_val).unwrap();
+                }
+                if is_query && let Some(query_scales) = query_scales {
+                    let scale = unsafe { *query_scales.add(head_idx * head_dim + index) };
+                    element = ElementT::from(element.to_f32().unwrap() * scale).unwrap();
+                }
+                unsafe {
+                    if is_query {
+                        *queries.add(head_idx * batch_dim * head_dim + batch_idx * head_dim + index) = element;
+                    } else if is_key {
+                        *keys.unwrap().add(
+                            (kv_token_offset + batch_idx) * num_kv_heads * head_dim
+                                + (head_idx - num_q_heads) * head_dim
+                                + index,
+                        ) = element;
+                    } else {
+                        *values.unwrap().add(
+                            (kv_token_offset + batch_idx) * num_kv_heads * head_dim
+                                + (head_idx - num_q_heads - num_kv_heads) * head_dim
+                                + index,
+                        ) = element;
+                    }
+                }
+            }
+        }
+    }
+}
