+
+const NORM_Q_HEADS: u32 = 4;
+const NORM_KV_HEADS: u32 = 2;
+const NORM_HEAD_DIM: u32 = 256;
+const NORM_ROPE_DIM: u32 = 64;
+const NORM_ROWS: u32 = 2;
+// Query, key and value heads, then a gate as wide as the queries.
+const NORM_ROW_STRIDE: u32 = (2 * NORM_Q_HEADS + 2 * NORM_KV_HEADS) * NORM_HEAD_DIM;
+
+struct NormInputs {
+    qkvg: Vec<bf16>,
+    query_norm_scales: Vec<f32>,
+    key_norm_scales: Vec<f32>,
+    query_scales: Vec<f32>,
+    cosines: Vec<f32>,
+    sines: Vec<f32>,
+}
+
+fn norm_inputs() -> NormInputs {
+    let wave = |seed: f32, count: u32| -> Vec<f32> {
+        (0..count).map(|index| (index as f32 * 0.37 + seed).sin() * 1.7 + (index as f32 * 0.011).cos()).collect()
+    };
+    NormInputs {
+        qkvg: wave(0.3, NORM_ROWS * NORM_ROW_STRIDE).into_iter().map(bf16::from_f32).collect(),
+        query_norm_scales: wave(1.1, NORM_HEAD_DIM).into_iter().map(|value| 0.5 + 0.2 * value).collect(),
+        key_norm_scales: wave(2.3, NORM_HEAD_DIM).into_iter().map(|value| 0.4 + 0.2 * value).collect(),
+        query_scales: wave(3.7, NORM_Q_HEADS * NORM_HEAD_DIM).into_iter().map(|value| 1.0 + 0.3 * value).collect(),
+        cosines: wave(4.1, NORM_ROWS * NORM_ROPE_DIM).into_iter().map(f32::cos).collect(),
+        sines: wave(4.1, NORM_ROWS * NORM_ROPE_DIM).into_iter().map(f32::sin).collect(),
+    }
+}
+
+/// Queries, keys and values from QKVNorm (query and key heads, in place) then AttentionPrepare, or from
+/// AttentionPrepareNorm alone. Without `norm_scales` both norms are unscaled (nGPT).
+fn run_prepare_norm<B: Backend>(
+    inputs: &NormInputs,
+    fused: bool,
+    full_layer: bool,
+    append_kv: bool,
+    norm_scales: bool,
+) -> Output {
+    use crate::backends::common::kernel::{AttentionPrepareNormKernel, QKVNormKernel};
+    let context = block_on(B::Context::new()).expect("context");
+    let mut qkvg = create_buffer_with_data::<B, bf16>(&context, &inputs.qkvg);
+    let query_norm_scales = create_buffer_with_data::<B, f32>(&context, &inputs.query_norm_scales);
+    let key_norm_scales = create_buffer_with_data::<B, f32>(&context, &inputs.key_norm_scales);
+    let query_scales = create_buffer_with_data::<B, f32>(&context, &inputs.query_scales);
+    let cosines = create_buffer_with_data::<B, f32>(&context, &inputs.cosines);
+    let sines = create_buffer_with_data::<B, f32>(&context, &inputs.sines);
+    let zeros = |count: u32| vec![bf16::ZERO; count as usize];
+    let mut queries = create_buffer_with_data::<B, bf16>(&context, &zeros(NORM_ROWS * NORM_Q_HEADS * NORM_HEAD_DIM));
+    let kv_len = (3 + NORM_ROWS) * NORM_KV_HEADS * NORM_HEAD_DIM;
+    let mut keys = create_buffer_with_data::<B, bf16>(&context, &zeros(kv_len));
+    let mut values = create_buffer_with_data::<B, bf16>(&context, &zeros(kv_len));
+    let (epsilons, offsets) = ([1e-6f32, 2e-6], [0.0f32, 0.25]);
+    let mut command_buffer = context.create_command_buffer(None, None).expect("command buffer");
+    if fused {
+        let kernel = <<B as Backend>::Kernels as Kernels>::AttentionPrepareNormKernel::new(
+            &context,
+            DataType::BF16,
+            DataType::F32,
+            append_kv,
+            true,
+            true,
+            full_layer,
+            true,
+            norm_scales,
+        )
+        .expect("prepare norm kernel");
+        kernel.encode(
+            &qkvg,
+            &mut queries,
+            append_kv.then_some(&mut keys),
+            append_kv.then_some(&mut values),
+            Some(&cosines),
+            Some(&sines),
+            Some(&query_scales),
+            norm_scales.then_some(&query_norm_scales),
+            norm_scales.then_some(&key_norm_scales),
+            NORM_Q_HEADS,
+            append_kv.then_some(NORM_KV_HEADS),
+            NORM_HEAD_DIM,
+            Some(NORM_ROPE_DIM),
+            append_kv.then_some(3),
+            NORM_ROW_STRIDE,
+            NORM_ROWS,
+            epsilons[0],
+            epsilons[1],
+            offsets[0],
+            offsets[1],
+            &mut command_buffer,
+        );
+    } else {
+        let norm = <<B as Backend>::Kernels as Kernels>::QKVNormKernel::new(
+            &context,
+            DataType::BF16,
+            DataType::F32,
+            DataType::BF16,
+            DataType::F32,
+            true,
+            norm_scales,
+        )
+        .expect("QKV norm kernel");
+        for (scales, epsilon, offset, head_offset, head_count) in [
+            (&query_norm_scales, epsilons[0], offsets[0], 0, NORM_Q_HEADS),
+            (&key_norm_scales, epsilons[1], offsets[1], NORM_Q_HEADS, NORM_KV_HEADS),
+        ] {
+            norm.encode(
+                None::<&B::GlobalBuffer>,
+                norm_scales.then_some(scales),
+                &mut qkvg,
+                NORM_ROWS,
+                NORM_ROW_STRIDE,
+                NORM_HEAD_DIM,
+                epsilon,
+                offset,
+                head_offset,
+                head_count,
+                full_layer,
+                true,
+                &mut command_buffer,
+            );
+        }
+        let prepare = <<B as Backend>::Kernels as Kernels>::AttentionPrepareKernel::new(
+            &context,
+            DataType::BF16,
+            DataType::F32,
+            append_kv,
+            true,
+            true,
+        )
+        .expect("prepare kernel");
+        prepare.encode(
+            &qkvg,
+            &mut queries,
+            append_kv.then_some(&mut keys),
+            append_kv.then_some(&mut values),
+            Some(&cosines),
+            Some(&sines),
+            Some(&query_scales),
+            NORM_Q_HEADS,
+            append_kv.then_some(NORM_KV_HEADS),
+            NORM_HEAD_DIM,
+            Some(NORM_ROPE_DIM),
+            append_kv.then_some(3),
+            NORM_ROW_STRIDE,
+            NORM_ROWS,
+            &mut command_buffer,
+        );
+    }
+    block_on(command_buffer.end_encoding().submit().wait_until_completed()).expect("wait");
+    Output {
+        queries: buffer_to_vec(&queries),
+        keys: buffer_to_vec(&keys),
+        values: buffer_to_vec(&values),
+    }
+}
+
+/// The fused prepare writes exactly what QKVNorm followed by AttentionPrepare writes, on every backend.
+#[uzu_test]
+fn test_attention_prepare_norm_matches_norm_then_prepare() {
+    let inputs = norm_inputs();
+    // The last two cases are Dory's (unscaled nGPT norms).
+    for (full_layer, append_kv, norm_scales) in
+        [(true, true, true), (false, true, true), (true, false, true), (true, true, false), (false, true, false)]
+    {
+        let check = |separate: Output, fused: Output, backend: &str| {
+            let case = format!("{backend}, full layer {full_layer}, append KV {append_kv}, norm scales {norm_scales}");
+            assert_eq!(separate.queries, fused.queries, "queries differ on {case}");
+            assert_eq!(separate.keys, fused.keys, "keys differ on {case}");
+            assert_eq!(separate.values, fused.values, "values differ on {case}");
+            assert!(separate.queries.iter().any(|value| value.to_f32() != 0.0), "no queries written on {case}");
+        };
+        check(
+            run_prepare_norm::<Cpu>(&inputs, false, full_layer, append_kv, norm_scales),
+            run_prepare_norm::<Cpu>(&inputs, true, full_layer, append_kv, norm_scales),
+            "Cpu",
+        );
+        for_each_non_cpu_backend!(|B| {
+            check(
+                run_prepare_norm::<B>(&inputs, false, full_layer, append_kv, norm_scales),
+                run_prepare_norm::<B>(&inputs, true, full_layer, append_kv, norm_scales),
+                std::any::type_name::<B>(),
+            );
+        });
+    }
+}
