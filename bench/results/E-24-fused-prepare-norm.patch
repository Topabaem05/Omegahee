+/// Query and key norm parameters for `AttentionPrepareNorm`, which applies both norms inside the prepare.
+pub(super) struct FusedNormParams<'a, B: Backend> {
+    /// Both present or both absent (nGPT's unit norms).
+    pub query_scales: Option<&'a B::GlobalBuffer>,
+    pub key_scales: Option<&'a B::GlobalBuffer>,
+    pub query_epsilon: f32,
+    pub key_epsilon: f32,
+    pub query_scale_offset: f32,
+    pub key_scale_offset: f32,
+    pub full_layer: bool,
+    pub sum_reduction: bool,
+}
